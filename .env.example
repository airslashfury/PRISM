# PostGIS (used by docker-compose and the loaders)
POSTGRES_DB=prism
POSTGRES_USER=prism
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# F13a Data Lab — read-only role (docker/initdb/02_readonly_role.sql / `make
# db-readonly-role`). Internal-only tool, no auth perimeter; change this only
# if you also update the role's password (ALTER ROLE prism_ro PASSWORD ...).
POSTGRES_RO_PASSWORD=prism_ro

# Keystone WFS — PR government (OGP / PRITS), ~400 geodatasets
WFS_URL=http://geoserver2.pr.gov/geoserver/pr_geodata/wfs

# API keys
CENSUS_API_KEY=
ANTHROPIC_API_KEY=
