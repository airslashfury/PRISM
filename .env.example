# PostGIS (used by docker-compose and the loaders)
POSTGRES_DB=prism
POSTGRES_USER=prism
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# F13a Data Lab — read-only role (docker/initdb/02_readonly_role.sql / `make
# db-readonly-role`). Not overridable via env: the password ('prism_ro') is
# hardcoded in both the SQL and api/deps.py::get_readonly_engine, since the
# fresh-volume initdb script can't read an env var. Internal-only tool, no
# auth perimeter — change both together if you ever need to rotate it.

# Keystone WFS — PR government (OGP / PRITS), ~400 geodatasets
WFS_URL=http://geoserver2.pr.gov/geoserver/pr_geodata/wfs

# API keys
CENSUS_API_KEY=
ANTHROPIC_API_KEY=
